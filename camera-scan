#!/usr/bin/env bash

set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VENV_PYTHON="$SCRIPT_DIR/.venv/bin/python3"

if [[ -x "$VENV_PYTHON" ]]; then
    PYTHON_BIN="$VENV_PYTHON"
else
    PYTHON_BIN=$(command -v python3 2>/dev/null || true)
fi

if [[ -z "$PYTHON_BIN" ]] || [[ ! -x "$PYTHON_BIN" ]]; then
    echo "ERROR: Python 3 is missing. Run: $SCRIPT_DIR/setup.sh" >&2
    exit 2
fi

case "${1:-}" in
    --help|-h|--check-dependencies|--check)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scanner.py" "$@"
        ;;
esac

# RealSense enumeration on macOS can require administrator access. The local
# virtual environment is referenced by an absolute path and remains available.
if [[ "$(uname -s)" == "Darwin" ]] &&
    [[ $EUID -ne 0 ]] &&
    [[ "${CAMERA_SCAN_NO_SUDO:-0}" != "1" ]]; then
    exec sudo "$0" "$@"
fi

exec "$PYTHON_BIN" "$SCRIPT_DIR/scanner.py" "$@"
